{
  "mcpServers": {
    "stitch": {
      "command": "npx",
      "args": [
        "-y",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "env": {
        "STITCH_PROJECT_ID": "${STITCH_PROJECT_ID}"
      }
    },
    "motion": {
      "url": "https://mcp.motion.dev"
    },
    "motion-plus": {
      "url": "https://mcp.motion.dev/plus"
    }
  }
}
