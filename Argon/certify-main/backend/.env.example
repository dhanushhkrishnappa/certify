PORT=5000
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
# For Production PostgreSQL 16:
# DATABASE_URL="postgresql://certify_app:STRONG_PASSWORD@db.internal:5432/certify?sslmode=require"

JWT_SECRET="replace_with_32_byte_cryptographic_random_secret_in_production"
JWT_EXPIRES_IN="2h"
CORS_ORIGIN="http://localhost:5173"

# AI Provider Configuration ("anthropic" | "openai")
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_TUTOR_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_EVALUATOR_MODEL="claude-3-5-haiku-20241022"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_TUTOR_MODEL="gpt-4o"
OPENAI_EVALUATOR_MODEL="gpt-4o-mini"

# Set to "false" in production so missing provider keys fail closed with HTTP 503
ALLOW_DEV_AI_FALLBACK="true"

# Optional PEM-encoded Ed25519 keypair for credential signing (auto-generated in dev if omitted)
ED25519_PRIVATE_KEY_PEM=""
ED25519_PUBLIC_KEY_PEM=""
