// ==============================================================================
// CERTIFY PLATFORM — LOCAL DEVELOPMENT DATABASE SCHEMA (SQLITE)
// ==============================================================================
// Mirrors prisma/schema.postgresql.prisma for zero-drift local testing.
// ==============================================================================

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. IDENTITY & BETTER AUTH DOMAIN
// ==============================================================================

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String       @default("")
  fullName      String       @default("")
  role          String       @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN
  emailVerified Boolean      @default(false)
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enrollments   Enrollment[]
  sessions      Session[]
  accounts      Account[]
  dailyActivity DailyActivity[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ==============================================================================
// 2. VERSIONED CURRICULUM HIERARCHY
// ==============================================================================

model Course {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  summary        String
  description    String
  level          String          @default("BEGINNER")
  category       String          @default("Software Engineering")
  durationHours  Int             @default(20)
  status         String          @default("PUBLISHED")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions       CourseVersion[]

  @@index([slug])
  @@index([status])
}

model CourseVersion {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber String       @default("1.0.0")
  changelog     String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  modules       Module[]
  enrollments   Enrollment[]

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@index([isActive])
}

model Module {
  id              String        @id @default(uuid())
  courseVersionId String
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sequenceOrder   Int
  createdAt       DateTime      @default(now())

  chapters        Chapter[]

  @@index([courseVersionId])
  @@index([courseVersionId, sequenceOrder])
}

model Chapter {
  id              String           @id @default(uuid())
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  sequenceOrder   Int
  teachingContent String
  estimatedMins   Int              @default(45)
  createdAt       DateTime         @default(now())

  concepts        Concept[]
  questions       Question[]
  sessions        LearningSession[]

  @@index([moduleId])
  @@index([moduleId, sequenceOrder])
}

model Concept {
  id             String           @id @default(uuid())
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String
  sequenceOrder  Int
  defaultP0      Float            @default(0.1500)
  createdAt      DateTime         @default(now())

  rubrics        Rubric[]
  conceptMastery ConceptMastery[]

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model Rubric {
  id        String            @id @default(uuid())
  conceptId String
  concept   Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime          @default(now())

  criteria  RubricCriterion[]

  @@index([conceptId])
}

model RubricCriterion {
  id                 String             @id @default(uuid())
  rubricId           String
  rubric             Rubric             @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criterionStatement String
  weight             Float              @default(1.0)
  tierRequired       String             @default("EASY")
  createdAt          DateTime           @default(now())

  masteryEvidences   MasteryEvidence[]
  rubricEvaluations  RubricEvaluation[]

  @@index([rubricId])
}

model Question {
  id           String             @id @default(uuid())
  chapterId    String
  chapter      Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionType String
  prompt       String
  tier         String             @default("EASY")
  parameters   String?
  options      String?
  createdAt    DateTime           @default(now())

  answers      AssessmentAnswer[]

  @@index([chapterId])
  @@index([chapterId, questionType])
}

// ==============================================================================
// 3. LEARNER ENROLLMENTS & HABIT TELEMETRY
// ==============================================================================

model Enrollment {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId  String
  courseVersion    CourseVersion     @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  status           String            @default("ACTIVE")
  currentTier      String            @default("EASY")
  enrolledAt       DateTime          @default(now())
  completedAt      DateTime?

  sessions         LearningSession[]
  conceptMasteries ConceptMastery[]
  assessments      AssessmentAttempt[]
  certificate      Certificate?

  @@unique([userId, courseVersionId])
  @@index([userId])
  @@index([courseVersionId])
  @@index([status])
}

model DailyActivity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate   DateTime
  minutesSpent   Int      @default(0)
  messagesCount  Int      @default(0)
  probesAnswered Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, activityDate])
  @@index([userId])
}

// ==============================================================================
// 4. SOCRATIC AI LEARNING STUDIO & CONVERSATIONAL SESSIONS
// ==============================================================================

model LearningSession {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  phase        String        @default("TEACHING")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  messages     ChatMessage[]

  @@index([enrollmentId])
  @@index([chapterId])
  @@index([enrollmentId, isActive])
}

model ChatMessage {
  id         String          @id @default(uuid())
  sessionId  String
  session    LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     String
  role       String          @default("user")
  content    String
  metadata   String?
  createdAt  DateTime        @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// ==============================================================================
// 5. DETERMINISTIC MASTERY & BAYESIAN KNOWLEDGE TRACING (BKT)
// ==============================================================================

model ConceptMastery {
  id                String            @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  conceptId         String
  concept           Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  pMastery          Float             @default(0.1500)
  confidence        Float             @default(0.2000)
  state             String            @default("UNENCOUNTERED")
  remediationCycles Int               @default(0)
  lastAssessedAt    DateTime?
  updatedAt         DateTime          @updatedAt

  evidences         MasteryEvidence[]

  @@unique([enrollmentId, conceptId])
  @@index([enrollmentId])
  @@index([conceptId])
  @@index([state])
}

model MasteryEvidence {
  id                 String           @id @default(uuid())
  conceptMasteryId   String
  conceptMastery     ConceptMastery   @relation(fields: [conceptMasteryId], references: [id], onDelete: Cascade)
  rubricCriterionId  String?
  rubricCriterion    RubricCriterion? @relation(fields: [rubricCriterionId], references: [id])
  evidenceType       String
  isDemonstrated     Boolean
  evidenceQuote      String?
  evaluatorReasoning String?
  observedAt         DateTime         @default(now())

  @@index([conceptMasteryId])
  @@index([rubricCriterionId])
  @@index([evidenceType])
}

// ==============================================================================
// 6. ASSESSMENTS, PRACTICAL TASKS & ORAL VIVA DEFENSE
// ==============================================================================

model AssessmentAttempt {
  id             String             @id @default(uuid())
  enrollmentId   String
  enrollment     Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessmentType String
  targetId       String?
  status         String             @default("IN_PROGRESS")
  score          Float?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  answers        AssessmentAnswer[]
  vivaTurns      VivaDefenseTurn[]
  practicalRuns  PracticalSubmission[]

  @@index([enrollmentId])
  @@index([enrollmentId, assessmentType])
}

model AssessmentAnswer {
  id            String             @id @default(uuid())
  attemptId     String
  attempt       AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswer String
  score         Float?
  createdAt     DateTime           @default(now())

  evaluations   RubricEvaluation[]

  @@index([attemptId])
  @@index([questionId])
}

model RubricEvaluation {
  id                String           @id @default(uuid())
  answerId          String
  answer            AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  rubricCriterionId String
  rubricCriterion   RubricCriterion  @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  isDemonstrated    Boolean
  confidence        Float            @default(0.85)
  evidenceQuote     String?
  reasoning         String?
  createdAt         DateTime         @default(now())

  @@index([answerId])
  @@index([rubricCriterionId])
}

model PracticalSubmission {
  id              String            @id @default(uuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskId          String
  submittedCode   String
  language        String            @default("python")
  testsRun        Int               @default(0)
  testsPassed     Int               @default(0)
  testResults     String
  score           Float             @default(0.0)
  passed          Boolean           @default(false)
  executionTimeMs Int               @default(0)
  outputLog       String?
  submittedAt     DateTime          @default(now())

  @@index([attemptId])
}

model VivaDefenseTurn {
  id               String            @id @default(uuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  turnNumber       Int
  questionPrompt   String
  studentAnswer    String
  turnScore        Float
  isDemonstrated   Boolean
  feedback         String
  followUpProbe    String?
  modelUsed        String?
  createdAt        DateTime          @default(now())

  @@unique([attemptId, turnNumber])
  @@index([attemptId])
}

// ==============================================================================
// 7. DETERMINISTIC VERIFIABLE CREDENTIALS & PUBLIC CRYPTOGRAPHIC LEDGER
// ==============================================================================

model Certificate {
  id               String     @id @default(uuid())
  credentialId     String     @unique
  enrollmentId     String     @unique
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  tier             String
  compositeScore   Float
  evidenceSummary  String
  signatureHash    String
  keyId            String     @default("certify-2026-key-1")
  status           String     @default("VALID")
  issuedAt         DateTime   @default(now())
  revokedAt        DateTime?
  revocationReason String?

  @@index([credentialId])
  @@index([status])
  @@index([tier])
}

model SigningKeyRegistry {
  id             String    @id @default(uuid())
  keyId          String    @unique
  algorithm      String    @default("Ed25519")
  publicKeyPem   String
  keyFingerprint String
  status         String    @default("ACTIVE")
  validFrom      DateTime  @default(now())
  validUntil     DateTime?

  @@index([keyId])
  @@index([status])
}

// ==============================================================================
// 8. PRIVATE CLOUDFLARE R2 VAULT & AUDITABLE TRANSACTIONAL LOGS
// ==============================================================================

model StorageArtifact {
  id           String   @id @default(uuid())
  storageKey   String   @unique
  enrollmentId String
  userId       String
  fileSize     Int
  mimeType     String
  checksum     String?
  uploadedAt   DateTime @default(now())

  @@index([enrollmentId])
  @@index([userId])
}

model EmailLog {
  id             String   @id @default(uuid())
  recipient      String
  template       String
  idempotencyKey String   @unique
  status         String   @default("SENT")
  errorDetails   String?
  sentAt         DateTime @default(now())

  @@index([recipient])
  @@index([idempotencyKey])
}
