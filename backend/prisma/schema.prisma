// ==============================================================================
// CERTIFY PLATFORM — PRODUCTION DATABASE SCHEMA (POSTGRESQL / NEON SERVERLESS)
// ==============================================================================
// Engine: Prisma 5.22+ with Neon Serverless Driver Adapter
// Architecture: Clean Domain Isolation (Auth, Curriculum, Sessions, BKT, Viva, Certs)
// Conformance: Better Auth Core Specs + Ed25519 Cryptographic Ledger + BKT Mastery
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ==============================================================================
// 1. IDENTITY & BETTER AUTH DOMAIN
// ==============================================================================
// Fully complies with Better Auth specifications while providing Certify
// extended fields (fullName, role, academic credentials).

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  name                String            @default("")
  fullName            String            @default("")
  role                String            @default("STUDENT") // STUDENT | INSTRUCTOR | ADMIN
  emailVerified       Boolean           @default(false)
  image               String?
  bio                 String?
  timezone            String?           @default("UTC")
  language            String?           @default("en")
  dob                 String?           // Date of birth: YYYY-MM-DD
  persona             String?           // e.g. "Software Engineer" | "University Student"
  primaryGoal         String?           // e.g. "Python & Backend Systems"
  onboardingCompleted Boolean           @default(false)
  passwordHash        String?           // Backward compatibility during migration
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Domain Relations
  enrollments         Enrollment[]
  sessions            Session[]
  accounts            Account[]
  dailyActivity       DailyActivity[]
  storageArtifacts    StorageArtifact[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Hashed password for email/password provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ==============================================================================
// 2. VERSIONED CURRICULUM HIERARCHY
// ==============================================================================
// Course -> CourseVersion -> Module -> Chapter -> Concept -> Rubric -> Criterion
// Versioning ensures student progress & issued certificates remain immutably tied
// to the exact syllabus version they completed.

model Course {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  summary        String
  description    String
  level          String          @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  category       String          @default("Software Engineering")
  durationHours  Int             @default(20)
  status         String          @default("PUBLISHED") // DRAFT | REVIEW | PUBLISHED | ARCHIVED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions       CourseVersion[]

  @@index([slug])
  @@index([status])
  @@map("courses")
}

model CourseVersion {
  id            String       @id @default(uuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber String       @default("1.0.0")
  changelog     String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  modules       Module[]
  enrollments   Enrollment[]

  @@unique([courseId, versionNumber])
  @@index([courseId])
  @@index([isActive])
  @@map("course_versions")
}

model Module {
  id                   String           @id @default(uuid())
  courseVersionId      String
  courseVersion        CourseVersion    @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  slug                 String           @default("")
  title                String
  description          String?
  sequenceOrder        Int
  prerequisiteModuleId String?
  practicalTaskId      String?
  minMasteryThreshold  Float            @default(0.70)
  createdAt            DateTime         @default(now())

  chapters             Chapter[]
  moduleProgresses     ModuleProgress[]

  @@index([courseVersionId])
  @@index([courseVersionId, sequenceOrder])
  @@index([courseVersionId, slug])
  @@map("modules")
}

model Chapter {
  id                 String            @id @default(uuid())
  moduleId           String
  module             Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String
  sequenceOrder      Int
  teachingContent    String            // First-principles pedagogical notes & Socratic boundaries
  estimatedMins      Int               @default(45)
  createdAt          DateTime          @default(now())

  sections           LessonSection[]
  concepts           Concept[]
  questions          Question[]
  sessions           LearningSession[]
  currentEnrollments Enrollment[]
  chapterProgresses  ChapterProgress[]
  embeddings         CourseEmbedding[]

  @@index([moduleId])
  @@index([moduleId, sequenceOrder])
  @@map("chapters")
}

model LessonSection {
  id                 String            @id @default(uuid())
  chapterId          String
  chapter            Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sectionType        String            // CONCEPT_INTUITION | TECHNICAL_MECHANICS | PITFALLS_AND_DEBUGGING | CHAPTER_CHECKPOINT | MODULE_PRACTICAL
  title              String
  objective          String            // Explicit learning objective injected into Socratic tutor
  sequenceOrder      Int               // 1, 2, 3, 4, (5)
  content            String            // Structured markdown slice scoped to this section
  minTurns           Int               @default(1)
  requiredForAdvance Boolean           @default(true)
  createdAt          DateTime          @default(now())

  sectionProgresses  SectionProgress[]
  embeddings         CourseEmbedding[]

  @@unique([chapterId, sequenceOrder])
  @@index([chapterId])
  @@map("lesson_sections")
}

model Concept {
  id             String           @id @default(uuid())
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String
  sequenceOrder  Int
  defaultP0      Float            @default(0.1500) // Default prior for Bayesian Knowledge Tracing
  createdAt      DateTime         @default(now())

  rubrics        Rubric[]
  conceptMastery ConceptMastery[]
  questions      Question[]
  embeddings     CourseEmbedding[]

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@map("concepts")
}

model Rubric {
  id        String            @id @default(uuid())
  conceptId String
  concept   Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime          @default(now())

  criteria  RubricCriterion[]

  @@index([conceptId])
  @@map("rubrics")
}

model RubricCriterion {
  id                   String                    @id @default(uuid())
  rubricId             String
  rubric               Rubric                    @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criterionCode        String?                   // e.g. "M01-C01-R01"
  criterionStatement   String                    // Concrete requirement (e.g. "Distinguishes object reference from value")
  weight               Float                     @default(1.0)
  tierRequired         String                    @default("EASY")    // EASY | MEDIUM | HARD
  cognitiveLevel       String                    @default("EXPLAIN") // RECALL | EXPLAIN | APPLY | DEBUG | REASON
  passingThreshold     Float                     @default(0.70)
  expectedConceptsJson String?                   // JSON array of key semantic signals
  misconceptionsJson   String?                   // JSON array of { tag, pattern, explanation }
  createdAt            DateTime                  @default(now())

  masteryEvidences     MasteryEvidence[]
  rubricEvaluations    RubricEvaluation[]
  criterionMasteries   RubricCriterionMastery[]
  skillMappings        RubricCriterionSkillMap[]

  @@index([rubricId])
  @@index([cognitiveLevel])
  @@map("rubric_criteria")
}

model Question {
  id           String             @id @default(uuid())
  chapterId    String
  chapter      Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  conceptId    String?
  concept      Concept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  questionType String             // RECALL | EXPLAIN | REASON | DEBUG | APPLY | VIVA | DIAGNOSTIC
  prompt       String
  tier         String             @default("EASY")
  parameters   String?            // JSON parameters for dynamic template variations
  options      String?            // JSON string array for diagnostic multiple-choice probes
  createdAt    DateTime           @default(now())

  answers      AssessmentAnswer[]

  @@index([chapterId])
  @@index([conceptId])
  @@index([chapterId, questionType])
  @@map("questions")
}

// ==============================================================================
// 3. LEARNER ENROLLMENTS & HABIT TELEMETRY
// ==============================================================================

model Enrollment {
  id                       String                   @id @default(uuid())
  userId                   String
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersionId          String
  courseVersion            CourseVersion            @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  currentChapterId         String?
  currentChapter           Chapter?                 @relation(fields: [currentChapterId], references: [id], onDelete: SetNull)
  status                   String                   @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED | REMEDIATING
  currentTier              String                   @default("EASY")   // EASY (Foundation) | MEDIUM (Proficient) | HARD (Advanced)
  enrolledAt               DateTime                 @default(now())
  completedAt              DateTime?

  sessions                 LearningSession[]
  conceptMasteries         ConceptMastery[]
  moduleProgresses         ModuleProgress[]
  chapterProgresses        ChapterProgress[]
  sectionProgresses        SectionProgress[]
  rubricCriterionMasteries RubricCriterionMastery[]
  skillProfiles            LearnerSkillProfile[]
  driftEvents              TopicDriftEvent[]
  assessments              AssessmentAttempt[]
  storageArtifacts         StorageArtifact[]
  certificate              Certificate?

  @@unique([userId, courseVersionId])
  @@index([userId])
  @@index([courseVersionId])
  @@index([currentChapterId])
  @@index([status])
  @@map("enrollments")
}

model DailyActivity {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate   DateTime // Truncated to YYYY-MM-DD
  minutesSpent   Int      @default(0)
  messagesCount  Int      @default(0)
  probesAnswered Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, activityDate])
  @@index([userId])
  @@map("daily_activities")
}

// ==============================================================================
// 4. SOCRATIC AI LEARNING STUDIO & CONVERSATIONAL SESSIONS
// ==============================================================================

model LearningSession {
  id               String            @id @default(uuid())
  enrollmentId     String
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  currentSectionId String?
  activeConceptId  String?
  turnCount        Int               @default(0)
  phase            String            @default("TEACHING") // DIAGNOSTIC | TEACHING | CHECKING | REMEDIATING | ASSESSING | COMPLETED
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  messages         ChatMessage[]
  driftEvents      TopicDriftEvent[]

  @@index([enrollmentId])
  @@index([chapterId])
  @@index([enrollmentId, isActive])
  @@map("learning_sessions")
}

model ChatMessage {
  id         String          @id @default(uuid())
  sessionId  String
  session    LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender     String          // USER | AI_TUTOR | AI_EVALUATOR | SYSTEM
  role       String          @default("user") // user | assistant | system
  content    String
  metadata   String?         // JSON metadata (tokens, latencyMs, model, streamed)
  createdAt  DateTime        @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ==============================================================================
// 5. DETERMINISTIC MASTERY & BAYESIAN KNOWLEDGE TRACING (BKT)
// ==============================================================================
// Probability pMastery P(L_t) is updated deterministically via Bayes Rule.
// The LLM evaluates rubrics; pure code updates pMastery.

model ConceptMastery {
  id                String            @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  conceptId         String
  concept           Concept           @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  pMastery          Float             @default(0.1500) // P(L_t) [0.0100 - 0.9900]
  confidence        Float             @default(0.2000)
  state             String            @default("UNENCOUNTERED") // UNENCOUNTERED | LEARNING | NEEDS_REMEDIATION | MASTERED | ADVANCED
  remediationCycles Int               @default(0)
  lastAssessedAt    DateTime?
  updatedAt         DateTime          @updatedAt

  evidences         MasteryEvidence[]

  @@unique([enrollmentId, conceptId])
  @@index([enrollmentId])
  @@index([conceptId])
  @@index([state])
  @@map("concept_masteries")
}

model MasteryEvidence {
  id                 String           @id @default(uuid())
  conceptMasteryId   String
  conceptMastery     ConceptMastery   @relation(fields: [conceptMasteryId], references: [id], onDelete: Cascade)
  rubricCriterionId  String?
  rubricCriterion    RubricCriterion? @relation(fields: [rubricCriterionId], references: [id], onDelete: SetNull)
  sectionId          String?
  evidenceType       String           // DIALOGUE_PROBE | CHAPTER_ASSESSMENT | PRACTICAL_TASK | VIVA | DIAGNOSTIC
  isDemonstrated     Boolean
  score              Float?
  confidence         Float?
  misconceptionTag   String?
  evidenceQuote      String?          // Exact student response quote proving comprehension
  evaluatorReasoning String?          // Structured evaluator reasoning
  observedAt         DateTime         @default(now())

  @@index([conceptMasteryId])
  @@index([rubricCriterionId])
  @@index([evidenceType])
  @@map("mastery_evidences")
}

// ==============================================================================
// 6. ASSESSMENTS, PRACTICAL TASKS & ORAL VIVA DEFENSE
// ==============================================================================

model AssessmentAttempt {
  id             String             @id @default(uuid())
  enrollmentId   String
  enrollment     Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessmentType String             // DIAGNOSTIC | CHAPTER | PRACTICAL | VIVA
  targetId       String?            // ChapterId or TaskId
  status         String             @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | EVALUATED | CANCELLED
  score          Float?             // Normalized score [0.0 - 1.0]
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  answers        AssessmentAnswer[]
  vivaTurns      VivaDefenseTurn[]
  practicalRuns  PracticalSubmission[]

  @@index([enrollmentId])
  @@index([enrollmentId, assessmentType])
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id            String             @id @default(uuid())
  attemptId     String
  attempt       AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswer String
  score         Float?
  createdAt     DateTime           @default(now())

  evaluations   RubricEvaluation[]

  @@index([attemptId])
  @@index([questionId])
  @@map("assessment_answers")
}

model RubricEvaluation {
  id                String           @id @default(uuid())
  answerId          String
  answer            AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  rubricCriterionId String
  rubricCriterion   RubricCriterion  @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  isDemonstrated    Boolean
  confidence        Float            @default(0.85)
  evidenceQuote     String?
  reasoning         String?
  createdAt         DateTime         @default(now())

  @@index([answerId])
  @@index([rubricCriterionId])
  @@map("rubric_evaluations")
}

model PracticalSubmission {
  id              String            @id @default(uuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskId          String            // e.g. "practical-summarize-scores"
  submittedCode   String
  language        String            @default("python")
  testsRun        Int               @default(0)
  testsPassed     Int               @default(0)
  testResults     String            // JSON serialized test harness breakdown
  score           Float             @default(0.0)
  passed          Boolean           @default(false)
  executionTimeMs Int               @default(0)
  outputLog       String?
  submittedAt     DateTime          @default(now())

  @@index([attemptId])
  @@map("practical_submissions")
}

model VivaDefenseTurn {
  id               String            @id @default(uuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  turnNumber       Int               // 1, 2, 3 (Three-turn oral defense)
  questionPrompt   String
  studentAnswer    String
  turnScore        Float             // [0.0 - 1.0]
  isDemonstrated   Boolean
  feedback         String
  followUpProbe    String?
  modelUsed        String?
  createdAt        DateTime          @default(now())

  @@unique([attemptId, turnNumber])
  @@index([attemptId])
  @@map("viva_defense_turns")
}

// ==============================================================================
// 7. DETERMINISTIC VERIFIABLE CREDENTIALS & PUBLIC CRYPTOGRAPHIC LEDGER
// ==============================================================================

model Certificate {
  id               String     @id @default(uuid())
  credentialId     String     @unique // e.g. "CERT-2026-PY-18429"
  enrollmentId     String     @unique
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  tier             String     // FOUNDATION | PROFICIENT | ADVANCED
  compositeScore   Float      // Deterministic 5-component weighted score
  evidenceSummary  String     // JSON-serialized canonical proof
  signatureHash    String     // RFC 8032 Ed25519 digital signature (hex)
  keyId            String     @default("certify-2026-key-1")
  status           String     @default("VALID") // VALID | REVOKED | SUSPENDED
  issuedAt         DateTime   @default(now())
  revokedAt        DateTime?
  revocationReason String?

  @@index([credentialId])
  @@index([status])
  @@index([tier])
  @@map("certificates")
}

model SigningKeyRegistry {
  id             String    @id @default(uuid())
  keyId          String    @unique // e.g. "certify-2026-key-1"
  algorithm      String    @default("Ed25519")
  publicKeyPem   String
  keyFingerprint String
  status         String    @default("ACTIVE") // ACTIVE | HISTORICAL | REVOKED
  validFrom      DateTime  @default(now())
  validUntil     DateTime?

  @@index([keyId])
  @@index([status])
  @@map("signing_key_registry")
}

// ==============================================================================
// 8. PRIVATE CLOUDFLARE R2 VAULT & AUDITABLE TRANSACTIONAL LOGS
// ==============================================================================

model StorageArtifact {
  id           String     @id @default(uuid())
  storageKey   String     @unique
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileSize     Int
  mimeType     String
  checksum     String?
  uploadedAt   DateTime   @default(now())

  @@index([enrollmentId])
  @@index([userId])
  @@map("storage_artifacts")
}

model EmailLog {
  id             String   @id @default(uuid())
  recipient      String
  template       String   // e.g. "CERTIFICATE_ISSUED" | "WELCOME"
  idempotencyKey String   @unique
  status         String   @default("SENT") // SENT | FAILED | BLOCKED | DUPLICATE
  errorDetails   String?
  sentAt         DateTime @default(now())

  @@index([recipient])
  @@index([idempotencyKey])
  @@map("email_logs")
}

// ==============================================================================
// 9. RAG KNOWLEDGE BASE DOMAIN (PGVECTOR)
// ==============================================================================
// Dense vector embeddings (1536-dim) + Full-Text Search (tsvector)
// Scoped to Python Fundamentals curriculum for grounded Socratic AI tutoring.

model CourseEmbedding {
  id             String         @id @default(uuid())
  chapterId      String?        @map("chapter_id")
  chapter        Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sectionId      String?        @map("section_id")
  section        LessonSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  conceptId      String?        @map("concept_id")
  concept        Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  moduleSlug     String         @map("module_slug")
  moduleOrder    Int            @default(1) @map("module_order")
  chunkType      String         @map("chunk_type") // LESSON | COMMON_MISTAKE | EXAMPLE
  embeddingModel String         @default("gemini-embedding-001") @map("embedding_model")
  content        String
  embedding      Unsupported("vector(1536)")?
  fts            Unsupported("tsvector")? @default(dbgenerated())
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([chapterId])
  @@index([sectionId])
  @@index([conceptId])
  @@index([moduleSlug])
  @@index([moduleSlug, moduleOrder])
  @@index([chunkType])
  @@map("course_embeddings")
}

// ==============================================================================
// 10. BACKEND-AUTHORITATIVE PROGRESSION STATE MACHINE & SKILL ANALYTICS
// ==============================================================================

model ModuleProgress {
  id                String     @id @default(uuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId          String
  module            Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status            String     @default("LOCKED") // LOCKED | UNLOCKED | IN_PROGRESS | COMPLETED
  chaptersCompleted Int        @default(0)
  totalChapters     Int        @default(0)
  practicalPassed   Boolean    @default(false)
  practicalScore    Float?
  moduleRubricScore Float?
  unlockedAt        DateTime?
  completedAt       DateTime?
  updatedAt         DateTime   @updatedAt

  @@unique([enrollmentId, moduleId])
  @@index([enrollmentId, status])
  @@map("module_progress")
}

model ChapterProgress {
  id                  String     @id @default(uuid())
  enrollmentId        String
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chapterId           String
  chapter             Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status              String     @default("LOCKED") // LOCKED | UNLOCKED | IN_PROGRESS | AWAITING_CHECKPOINT | REMEDIATING | COMPLETED
  currentSectionOrder Int        @default(1)
  checkpointScore     Float?
  checkpointAttempts  Int        @default(0)
  remediationCycles   Int        @default(0)
  unlockedAt          DateTime?
  completedAt         DateTime?
  updatedAt           DateTime   @updatedAt

  @@unique([enrollmentId, chapterId])
  @@index([enrollmentId, status])
  @@map("chapter_progress")
}

model SectionProgress {
  id              String        @id @default(uuid())
  enrollmentId    String
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sectionId       String
  section         LessonSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status          String        @default("LOCKED") // LOCKED | UNLOCKED | IN_PROGRESS | COMPLETED
  turnsCompleted  Int           @default(0)
  rubricPassRatio Float         @default(0.0)
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt

  @@unique([enrollmentId, sectionId])
  @@index([enrollmentId, status])
  @@map("section_progress")
}

model RubricCriterionMastery {
  id                 String          @id @default(uuid())
  enrollmentId       String
  enrollment         Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  rubricCriterionId  String
  rubricCriterion    RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  status             String          @default("NOT_STARTED") // NOT_STARTED | ATTEMPTED | PARTIAL | DEMONSTRATED | MASTERED
  pCriterion         Float           @default(0.1500)
  bestScore          Float           @default(0.0)
  latestScore        Float           @default(0.0)
  demonstratedCount  Int             @default(0)
  failedCount        Int             @default(0)
  misconceptionCount Int             @default(0)
  lastMisconception  String?
  lastEvidenceQuote  String?
  lastEvaluatedAt    DateTime?
  updatedAt          DateTime        @updatedAt

  @@unique([enrollmentId, rubricCriterionId])
  @@index([enrollmentId, status])
  @@index([rubricCriterionId])
  @@map("rubric_criterion_masteries")
}

model SkillDimension {
  id           String                    @id @default(uuid())
  courseSlug   String
  slug         String
  name         String
  description  String
  displayOrder Int                       @default(1)

  criterionMappings RubricCriterionSkillMap[]
  learnerProfiles   LearnerSkillProfile[]

  @@unique([courseSlug, slug])
  @@map("skill_dimensions")
}

model RubricCriterionSkillMap {
  id                 String          @id @default(uuid())
  rubricCriterionId  String
  rubricCriterion    RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Cascade)
  skillDimensionId   String
  skillDimension     SkillDimension  @relation(fields: [skillDimensionId], references: [id], onDelete: Cascade)
  contributionWeight Float           @default(1.0)

  @@unique([rubricCriterionId, skillDimensionId])
  @@index([skillDimensionId])
  @@map("rubric_criterion_skill_map")
}

model LearnerSkillProfile {
  id                  String         @id @default(uuid())
  enrollmentId        String
  enrollment          Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  skillDimensionId    String
  skillDimension      SkillDimension @relation(fields: [skillDimensionId], references: [id], onDelete: Cascade)
  compositeScore      Float          @default(0.0)
  rubricPassRate      Float          @default(0.0)
  bktMeanMastery      Float          @default(0.15)
  practicalScore      Float?
  criteriaEvaluated   Int            @default(0)
  criteriaTotal       Int            @default(0)
  misconceptionCount  Int            @default(0)
  classification      String         @default("UNASSESSED") // UNASSESSED | WEAKPOINT | DEVELOPING | STRENGTH
  weakestCriteriaJson String?
  computedAt          DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([enrollmentId, skillDimensionId])
  @@index([enrollmentId, classification])
  @@map("learner_skill_profiles")
}

model TopicDriftEvent {
  id                 String          @id @default(uuid())
  sessionId          String
  session            LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId       String
  enrollment         Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activeChapterId    String
  activeSectionId    String?
  driftType          String          // FUTURE_TOPIC | SKIP_ATTEMPT | OFF_TOPIC
  detectedTargetSlug String?
  learnerMessage     String
  createdAt          DateTime        @default(now())

  @@index([enrollmentId])
  @@index([sessionId])
  @@map("topic_drift_events")
}

