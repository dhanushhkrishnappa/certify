{
  "name": "certify-backend",
  "version": "1.0.0",
  "description": "Production AI Learning & Certification Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:neon:generate": "prisma generate",
    "db:neon:push": "prisma db push",
    "db:neon:migrate": "prisma migrate dev",
    "db:users": "node scripts/manage_users.cjs list",
    "db:delete-user": "node scripts/manage_users.cjs delete",
    "rag:ingest": "tsx scripts/ingest_python_rag.ts",
    "test:chat": "tsx scripts/verify_chat_e2e.ts"
  },
  "keywords": [
    "ai",
    "learning",
    "certification",
    "edtech",
    "socratic",
    "bkt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.20.0",
    "better-auth": "^1.7.16",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "nodemailer": "^10.5.0",
    "resend": "^6.34.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.152.0"
  }
}
