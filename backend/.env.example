PORT=5000
NODE_ENV="development"

# ─── Database Configuration ──────────────────────────────────────────────────
# Local SQLite Dev:
DATABASE_URL="file:./prisma/dev.db"

# Production Neon PostgreSQL (replace with your Neon pooler connection string):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-12345-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Better Auth Configuration ───────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET="certify_better_auth_dev_secret_32chars_minimum"
BETTER_AUTH_URL="http://localhost:5000"

# ─── AI Providers ─────────────────────────────────────────────────────────────
AI_PROVIDER="anthropic" # anthropic | gemini | openai
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_TUTOR_MODEL="claude-sonnet-4-6"
ANTHROPIC_EVALUATOR_MODEL="claude-haiku-4-5-20251001"

# Gemini auto-fallback when Anthropic rate limits are hit
GEMINI_API_KEY=""
GEMINI_TUTOR_MODEL="gemini-2.5-flash"
GEMINI_AUTO_FALLBACK="true"
ALLOW_DEV_AI_FALLBACK="true"

# ─── Ed25519 Cryptographic Signatures ─────────────────────────────────────────
# In dev, an ephemeral key is auto-generated if left blank.
# In prod, generate with Node.js crypto.generateKeyPairSync('ed25519')
ED25519_PRIVATE_KEY_PEM=""
ED25519_PUBLIC_KEY_PEM=""
ED25519_KEY_ID="certify-2026-key-1"

# ─── Transactional Emails (Gmail SMTP or Resend) ──────────────────────────────
# Option A: Gmail SMTP (Recommended - sends to ANY email without a custom domain)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_USER="certify.mailer.2026@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Option B: Resend (Requires verified custom domain to send to arbitrary addresses)
RESEND_API_KEY=""
EMAIL_FROM="Certify <credentials@certify.edu>"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN="https://certify.pages.dev"
